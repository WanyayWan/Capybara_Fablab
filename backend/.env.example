# Copy to backend/.env and edit. Never commit .env.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
EMBED_MODEL=nomic-embed-text
WHISPER_MODEL=base.en

RAG_TOP_K=3
RAG_THRESHOLD=0.5
RAG_MACHINE_BOOST=0.05

SESSION_TIMEOUT_S=120
SESSION_MAX_TURNS=6

MIN_RECORD_S=0.5
MAX_RECORD_S=15
PRE_ROLL_S=0.5

HELP_ACK_CLEAR_S=600

# Leave empty to print staff alerts to the console instead of Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PORT=8000
